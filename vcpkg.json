{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "lumin-engine",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    "glm",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "sdl3-binding"
      ]
    },
    "lua",
    "sol2",
    "tinyobjloader",
    "nvrhi",
    "vulkan-headers",
    "vulkan-loader",
    "stb"
  ]
}
